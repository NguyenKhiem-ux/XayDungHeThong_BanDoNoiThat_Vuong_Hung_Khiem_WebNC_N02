{
  "name": "giadung-shop-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test:addresses": "node --test -r ts-node/register src/addresses/addresses.service.spec.ts",
    "test:auth": "node --test -r ts-node/register src/auth/auth.service.spec.ts src/auth/auth-schema.spec.ts",
    "test:checkout": "node --test -r ts-node/register src/chat/checkout.spec.ts",
    "test:chat": "node --test -r ts-node/register src/chat/chat.spec.ts src/chat/shopping.spec.ts src/chat/user-actions.spec.ts",
    "test:shopping:mysql": "node scripts/verify-shopping.cjs",
    "db:chatbot": "node scripts/setup-chatbot.cjs",
    "db:checkout": "node scripts/setup-checkout.cjs",
    "db:auth-profile": "node scripts/setup-auth-profile.cjs",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/typeorm": "^11.0.3",
    "@payos/node": "^2.0.5",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "mysql2": "^3.24.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.20.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
