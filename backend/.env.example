PORT=3000
FRONTEND_URL=http://localhost:5173
# Đặt 1 khi chạy sau ngrok/reverse proxy để rate limit nhận đúng IP người dùng
TRUST_PROXY=

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=giadung_shop
DB_SYNCHRONIZE=false
# CA certificate của Aiven: đường dẫn file (tương đối với backend/, ví dụ certs/aiven-ca.pem) hoặc nội dung PEM.
# Để trống thì kết nối vẫn dùng SSL nhưng không kiểm tra chứng chỉ (chỉ nên dùng ở dev local).
DB_CA_CERT=

JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

UPLOAD_DIR=uploads/products
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5173/checkout/success
PAYOS_CANCEL_URL=http://localhost:5173/checkout

GEMINI_API_KEY=
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
