{
  "expo": {
    "name": "Gia dụng Việt",
    "slug": "gia-dung-viet",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "giadungviet",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép Gia dụng Việt truy cập ảnh để cập nhật ảnh đại diện.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
