# Expo Web: để trống API_URL để dùng /api qua proxy Metro đến Backend localhost.
# Android Emulator: dùng http://10.0.2.2:3000/api và origin http://10.0.2.2:3000.
# Điện thoại thật: thay bằng IP LAN hoặc URL HTTPS mà điện thoại truy cập được.
# API_URL chấp nhận cả Backend origin và URL kết thúc bằng /api; client chỉ thêm /api một lần.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
EXPO_PUBLIC_API_ORIGIN=http://localhost:3000
EXPO_PUBLIC_WEB_URL=http://localhost:5173
